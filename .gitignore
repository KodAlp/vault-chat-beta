# Cached model catalog (OpenRouter/models.dev), rebuilt automatically every 24 h.
data/model-catalog.json
# Which cloud providers this install's user agreed to send chat data to.
data/provider-consent.json
# Per-install UI preferences (theme, locale, models) written by /api/ui-prefs.
data/ui-prefs.json
# MCP: per-launch endpoint + token written by the app, and the user's allowed import folders.
data/mcp-endpoint.json
data/mcp-settings.json
