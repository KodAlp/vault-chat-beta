node_modules/
build/
dist-server/
.svelte-kit/
data/*.db
data/*.db-wal
data/*.db-shm
data/skills/
data/library/
data/secrets.json
# Faz 8 — vault registry + per-vault content, same reasons as the entries
# above (personal library content, regenerable indexes, local-only DBs).
data/vaults.json
data/vaults/
# Faz 10 — MCP server call log (tool name + param summary + duration
# only, never content — but still local-instance-specific, same
# treatment as the DB files above).
data/mcp-log.jsonl*
# Faz 11 — app-level error log (chat/fallback/title/db errors, metadata
# only, same treatment as mcp-log.jsonl above).
data/app-log.jsonl*
# F14-2 — disk cache of the OpenRouter/models.dev catalog fetch, rebuilt
# automatically (24h TTL); not source, same treatment as the DBs above.
data/model-catalog.json
# İ2 (Aşama 8) — which cloud providers this instance's user has consented
# to send chat data to; local-instance state, not source.
data/provider-consent.json
# Per-install UI preferences (theme, locale, models) written by /api/ui-prefs.
data/ui-prefs.json
.env
!.env.example

# Python sidecar (ingest/) — venv and any downloaded model weights, never
# tracked; requirements.txt itself is the reproducible spec.
ingest/__pycache__/
ingest/.venv/

# docker/linux-package.sh output (packages, launch log, screenshot).
docker-out/
# MCP: per-launch endpoint + token written by the app (never commit), and the user's allowed import folders.
data/mcp-endpoint.json
data/mcp-settings.json
