{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["**/*.ts", "../src/lib/server/embed-config.ts", "../src/lib/server/vaults.ts", "../src/lib/server/slug.ts"]
}
