{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "opener:default",
    "allow-check-and-start",
    "allow-save-vault-config-and-start",
    "allow-recheck-node",
    "allow-winget-install",
    "allow-winget-available",
    "allow-get-vault-config",
    "allow-update-vault-config",
    "allow-save-text-file",
    "allow-detect-local-servers",
    "allow-list-launchers",
    "allow-save-launcher",
    "allow-pick-launcher-program",
    "allow-redetect-launcher-program",
    "allow-start-launcher",
    "allow-stop-launcher",
    "allow-launcher-status"
  ]
}
