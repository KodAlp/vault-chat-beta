{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "opener:default"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  }
}
