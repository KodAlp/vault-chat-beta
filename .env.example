# Kütüphane kökü (Faz 5) — uygulamanın kendi data/library/ klasörü, artık
# Obsidian'a bağımlı değil. Boş bırakılırsa ./data/library varsayılır.
# LIBRARY_PATH=./data/library

# Deprecated: eski VAULT_PATH hâlâ çalışır (LIBRARY_PATH boşsa fallback),
# ama yeni kurulumlar LIBRARY_PATH kullanmalı.
VAULT_PATH=..

# Ollama native API
OLLAMA_URL=http://localhost:11434

# indexer'ın yazdığı, retrieve.ts'in salt okunur baktığı sqlite-vec dosyası
INDEX_DB_PATH=./data/vault-index.db

# konuşma geçmişi (Faz 1 kalıcılık) — chats-db.ts okur/yazar
CHATS_DB_PATH=./data/chats.db

# Obsidian'da vault'u açtığın isim (Ayarlar > Hakkında'da görünür) — kaynak
# çipleri obsidian://open?vault=... linki için bunu kullanır
PUBLIC_VAULT_NAME=First brain(Software based)
