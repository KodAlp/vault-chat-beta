# Vault kökü — bu dosya vault-chat/ içinde yaşadığı için varsayılan bir üst dizin
VAULT_PATH=..

# Ollama native API
OLLAMA_URL=http://localhost:11434

# indexer'ın yazdığı, retrieve.ts'in salt okunur baktığı sqlite-vec dosyası
INDEX_DB_PATH=./data/vault-index.db

# Obsidian'da vault'u açtığın isim (Ayarlar > Hakkında'da görünür) — kaynak
# çipleri obsidian://open?vault=... linki için bunu kullanır
PUBLIC_VAULT_NAME=First brain(Software based)
